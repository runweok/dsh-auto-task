{
  "name": "dsh-auto-task",
  "version": "1.0.0",
  "description": "Builds DSH scheduled tasks from plain schedule descriptions in one tool call: compiles once/daily/weekly/interval/cron rules, creates tasks in batch, and cleans up ended tasks.",
  "type": "module",
  "license": "MIT",
  "author": "runweok",
  "repository": {
    "type": "git",
    "url": "https://github.com/runweok/dsh-auto-task.git"
  },
  "homepage": "https://github.com/runweok/dsh-auto-task#readme",
  "engines": {
    "dsh": ">=0.2.1-rc.2 <0.3.0-0"
  },
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["index.js", "cordis.patch.yml", "locale/*.json", "icon.svg", "README.md"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" }
  }
}
